# --- Agent host / LLM engine -------------------------------------------------
# Ollama's OpenAI-compatible REST endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
# The assignment names `qwen3.5:4b`; no such tag is published, so we default to
# the equivalent lightweight model. Override freely.
OLLAMA_MODEL=qwen3:4b

# --- Servers -----------------------------------------------------------------
# Local HTTP MCP server (Part 2.2)
LOCAL_HTTP_PORT=3001
# Public HTTP MCP server (Part 2.3). `PORT` is what most PaaS hosts inject.
PORT=3002
# Bearer token required by the public HTTP server. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MCP_API_KEY=replace-me-with-a-long-random-string
# Where the public server persists standup entries.
DATA_DIR=./data

# --- Skill defaults ----------------------------------------------------------
# Repository the daily-standup skill inspects by default.
DEFAULT_REPO_PATH=/Users/maplelabs/22127086
